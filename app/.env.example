# ==============================================================================
# Ayaad — environment template
# Copy to .env.local and fill in. Never commit .env*.
# All services are managed; the only self-hosted piece is this Next.js app.
# ==============================================================================

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development
# AUTH_MODE is unused in B2B — email magic links replace Twilio OTP. Keep it unset.
AUTH_MODE=

# --- Database (Supabase Postgres) ---
# Create a project at https://supabase.com, free tier is fine for dev
# Get the "Connection string" from Project Settings → Database → URI (Session mode port 5432, not 6543)
DATABASE_URL=postgresql://postgres.PROJECT:PASSWORD@aws-0-eu-central-1.pooler.supabase.com:5432/postgres

# Supabase public URL + anon key for client-side (storage uploads only)
# Project Settings → API → Project URL + anon public key
NEXT_PUBLIC_SUPABASE_URL=https://PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGc...

# Service role key for server-side writes (bypasses RLS)
# Project Settings → API → service_role key — NEVER ship this to the browser
SUPABASE_SERVICE_ROLE_KEY=eyJhbGc...

# --- Payments (Stripe) ---
# Create account at https://stripe.com. Use TEST keys until replica-deploy runs.
# Dashboard → Developers → API keys
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Webhook secret: install Stripe CLI, run `stripe listen --forward-to localhost:3000/api/webhooks/stripe`
# The CLI prints a `whsec_...` secret; paste it here. On prod, create a webhook endpoint in the dashboard.
STRIPE_WEBHOOK_SECRET=whsec_...

# --- SMS reminders (Twilio) — OPTIONAL ---
# B2B uses email magic link for auth, so Twilio isn't needed for login.
# Only fill these if/when you add SMS reminders in a later milestone.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=

# --- Email (Resend) ---
# Create at https://resend.com, verify ayaad.ae domain (SPF/DKIM already set per memory)
# Dashboard → API Keys
RESEND_API_KEY=re_...
RESEND_FROM="Ayaad <noreply@ayaad.ae>"
RESEND_REPLY_TO=support@ayaad.ae

# --- ERP (Reonxt) ---
# Fill after co-design with Reonxt team. Idempotency key is the booking id.
REONXT_API_URL=https://api.reonxt.example.com/v1
REONXT_API_KEY=
REONXT_PUSH_ENABLED=false           # set true once Reonxt side is ready

# --- Legal entities (UAE VAT invoice issuance) ---
# Must match legal_entities table rows. Prefix is used in invoice numbers.
AYAAD_DMCC_TRN=100XXXXXXXXXXXX
AYAAD_LLC_TRN=100XXXXXXXXXXXX

# --- Monitoring (optional, add before launch) ---
SENTRY_DSN=
POSTHOG_KEY=
